<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Authors>IronyxLabs</Authors>
    <Description>Makes easier to use Kernel functionlity in .NET applications.</Description>
    <RepositoryUrl>https://github.com/IronyxLabs/ironyx-kernel</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>ironyx, kernel, cqs</PackageTags>
    <PackageReleaseNotes>https://github.com/IronyxLabs/ironyx-kernel/releases</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Endpoint\Generic.proto" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.21.5" />
    <PackageReference Include="Grpc.AspNetCore.Server" Version="2.49.0" />
    <PackageReference Include="Grpc.Net.ClientFactory" Version="2.49.0" />
    <PackageReference Include="Grpc.Tools" Version="2.49.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Scrutor" Version="7.0.0" />
  </ItemGroup>
  	
	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>
	
  <ItemGroup>
    <ProjectReference Include="..\Ironyx.Kernel.Abstraction\Ironyx.Kernel.Abstraction.csproj" />
    <ProjectReference Include="..\Ironyx.Kernel.Execution\Ironyx.Kernel.Execution.csproj" />
  </ItemGroup>
	
  <ItemGroup>
    <Protobuf Include="Endpoint\Generic.proto" GrpcServices="Both" />
  </ItemGroup>

</Project>
