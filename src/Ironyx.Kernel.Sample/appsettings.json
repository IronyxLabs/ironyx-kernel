{
    "Serilog": {
        "Usings": [ "Serilog.Sinks.Async", "Serilog.Sinks.Console", "Serilog.Sinks.GrafanaLoki" ],
        "MinimumLevel": {
            "Default": "Verbose",
            "Override": {
                "Microsoft": "Warning",
                "System": "Warning",
                "Grpc.Net": "Warning"
            }
        },
        "WriteTo": [
            {
                "Name": "Async",
                "Args": {
                    "configure": [
                        {
                            "Name": "Console",
                            "Args": {
                                "OutputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}",
                                "RestrictedToMinimumLevel": "Verbose"
                            }
                        },
                        {
                            "Name": "GrafanaLoki",
                            "Args": {
                                "Uri": "https://loki.mihben.space",
                                "restrictedToMinimumLevel": "Verbose",
                                "PropertiesAsLabels": [
                                    "Application",
                                    "Environment",
                                    "Service",
                                    "level"
                                ]
                            }
                        }
                    ]
                }
            }
        ],
        "Enrich": [ "FromLogContext" ],
        "Properties": {
            "Application": "Ironyx.Kernel",
            "Service": "Sample",
            "Environment": "Development"
        }
    }
}
